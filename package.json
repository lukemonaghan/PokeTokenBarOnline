{
  "name": "poketokenbaronline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/.bin/tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "SESSION_STORE=memory node node_modules/.bin/tsx --test src/*.test.ts",
    "test:integration": "SESSION_STORE=redis node --env-file-if-exists=.env node_modules/.bin/tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@pkmn/sim": "^0.10.11",
    "@pkmn/types": "^4.0.0",
    "@upstash/redis": "^1.38.2",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
